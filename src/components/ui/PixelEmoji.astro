---
import type { ImageMetadata } from 'astro';

interface Props {
  emoji: string;
  alt?: string;
  inline?: boolean;
  class?: string;
}

const { emoji, alt, inline = true, class: className } = Astro.props;

// Convert emoji string to hex codepoints (e.g. "🤑" -> "1f911")
const codePoints = Array.from(emoji)
  .map((char) => char.codePointAt(0)?.toString(16))
  .filter(Boolean)
  .join('-');

// Eagerly discover all SVGs in src/assets/emoji/
const svgModules = import.meta.glob<{ default: ImageMetadata }>('/src/assets/emoji/*.svg', {
  eager: true,
});

const targetKey = `/src/assets/emoji/${codePoints}.svg`;
const matchedModule = svgModules[targetKey];
const imageSrc =
  matchedModule?.default?.src || (matchedModule as unknown as { default: string })?.default;
const displayAlt = alt ?? emoji;
---

{imageSrc ? (
  <img
    src={imageSrc}
    alt={displayAlt}
    role="img"
    width="18"
    height="18"
    class:list={['pixel-emoji', { 'pixel-emoji--inline': inline }, className]}
    loading="lazy"
    decoding="async"
  />
) : (
  <span
    class:list={['pixel-emoji-text', { 'pixel-emoji--inline': inline }, className]}
    role="img"
    aria-label={displayAlt}
  >
    {emoji}
  </span>
)}

<style>
  .pixel-emoji {
    width: 18px;
    height: 18px;
    image-rendering: pixelated;
    image-rendering: crisp-edges;
  }

  .pixel-emoji--inline {
    display: inline-block;
    vertical-align: -0.2em;
  }

  .pixel-emoji-text {
    font-family: 'SerenityOS Emoji', system-ui, sans-serif;
  }
</style>
