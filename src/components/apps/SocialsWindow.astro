---
import PixelIcon from '../ui/PixelIcon.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;

const socials = [
  {
    name: 'Instagram',
    icon: 'instagram',
    label: '@papisartisticgarden',
    url: 'https://www.instagram.com/papisartisticgarden/',
    external: true,
  },
  {
    name: 'GitHub',
    icon: 'github',
    label: 'maztard',
    url: 'https://github.com/maztard',
    external: true,
  },
  {
    name: 'Email',
    icon: 'contact',
    label: 'mazenra100@gmail.com',
    url: 'mailto:mazenra100@gmail.com',
    external: false,
  },
];
---

<div class:list={['socials-window', className]}>
  <ul class="socials-list" role="list">
    {socials.map((item) => (
      <li class="socials-item">
        <a
          href={item.url}
          class="socials-link"
          target={item.external ? '_blank' : undefined}
          rel={item.external ? 'noopener noreferrer' : undefined}
        >
          <span class="socials-icon" aria-hidden="true">
            <PixelIcon name={item.icon} size={20} />
          </span>
          <span class="socials-content">
            <span class="socials-name">{item.name}</span>
            <span class="socials-label">{item.label}</span>
          </span>
          {item.external && (
            <span class="socials-arrow" aria-hidden="true">
              ↗
            </span>
          )}
        </a>
      </li>
    ))}
  </ul>
</div>

<style>
  .socials-window {
    padding: 0.5rem;
    background: #c0c0c0;
    font-family: var(--font-body, system-ui, sans-serif);
  }

  .socials-list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .socials-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    background: #ffffff;
    color: #1a1a1a;
    text-decoration: none;
    border-top: 2px solid #ffffff;
    border-left: 2px solid #ffffff;
    border-right: 2px solid #808080;
    border-bottom: 2px solid #808080;
    box-shadow:
      inset 1px 1px 0 #dfdfdf,
      inset -1px -1px 0 #000;
    transition: background 0.1s ease;
  }

  .socials-link:hover {
    background: #f0f0f0;
    color: var(--color-accent, #a52a2a);
  }

  .socials-link:active {
    border-top: 2px solid #808080;
    border-left: 2px solid #808080;
    border-right: 2px solid #ffffff;
    border-bottom: 2px solid #ffffff;
    box-shadow:
      inset 1px 1px 0 #000,
      inset -1px -1px 0 #dfdfdf;
    padding-top: calc(0.5rem + 1px);
    padding-left: calc(0.75rem + 1px);
  }

  .socials-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    color: #1a1a1a;
  }

  .socials-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .socials-name {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #666;
    font-weight: 700;
  }

  .socials-label {
    font-family: var(--font-display, monospace);
    font-size: 0.95rem;
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .socials-arrow {
    font-size: 0.9rem;
    color: #888;
  }
</style>
