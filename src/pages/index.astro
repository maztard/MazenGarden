---
import DesktopLayout from '../layouts/DesktopLayout.astro';
import DesktopBanner from '../components/desktop/DesktopBanner.astro';
import DesktopWindow from '../components/desktop/DesktopWindow.astro';
import AboutCanvas from '../components/apps/AboutCanvas.astro';
import MeetMazenWindow from '../components/apps/MeetMazenWindow.astro';
import SocialsWindow from '../components/apps/SocialsWindow.astro';
import ProjectsContent from '../components/apps/ProjectsContent.astro';
import WritingContent from '../components/apps/WritingContent.astro';
import RssContent from '../components/apps/RssContent.astro';
import { HOME_TITLE, SITE_DESCRIPTION } from '../consts';
---

<DesktopLayout title={HOME_TITLE} description={SITE_DESCRIPTION}>
  <DesktopBanner />
  <main id="main" class="desktop-stage">
    <div class="desktop-canvas-layer">
      <AboutCanvas />
    </div>
    <div class="desktop-windows-layer">
      <DesktopWindow windowId="photos" windowTitle="MEET-MAZEN" icon="photos" isOpen={true}>
        <MeetMazenWindow />
      </DesktopWindow>

      <DesktopWindow windowId="socials" windowTitle="SOCIALS" icon="contact" isOpen={true}>
        <SocialsWindow />
      </DesktopWindow>

      <DesktopWindow windowId="projects" windowTitle="PROJECTS" icon="projects" isOpen={false}>
        <ProjectsContent />
      </DesktopWindow>

      <DesktopWindow windowId="writing" windowTitle="WRITING" icon="writing" isOpen={false}>
        <WritingContent />
      </DesktopWindow>

      <DesktopWindow windowId="rss" windowTitle="RSS" icon="rss" isOpen={false}>
        <RssContent />
      </DesktopWindow>
    </div>
  </main>
</DesktopLayout>
